rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Product Images: Public read for storefront display; write allowed for uploads
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if true;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
